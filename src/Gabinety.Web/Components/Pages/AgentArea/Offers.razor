@page "/panel-agenta/oferty"
@attribute [Authorize]
@layout AgentLayout
@inherits AgentPage
@inject DirectoryClient Directory
@* Offers: the list first, with a confirmation step before "Wyłącz" (F-04, P-OFF-1) and a way back ("Włącz"). The new-offer form is closed by default: it opens from "Dodaj ofertę" (?nowa=1), from "Edytuj" (?edit=<id>), or when a posted form has to be shown again with its errors.
   Static server rendering with plain forms: the confirmation is a page state (?wylacz=<id>), so it works without JavaScript and can be linked. The price is typed in zloty and sent as integer grosz. *@
<PageTitle>@PlAgent.Offers.MetaTitle</PageTitle>
<h1>@PlAgent.Offers.Title</h1>

@if (LoadFailure is not null)
{
    <Alert Variant="AlertVariant.Danger" TestId="unavailable">@FailureText(LoadFailure) <a href="@At(AgentPaths.Offers)">@PlAgent.Common.Retry</a></Alert>
}
else if (_loaded)
{
    <p class="muted" data-testid="active-count">@string.Format(PlAgent.Offers.ActiveCount, _active)</p>
    @if (_listNote is not null) {<Alert Variant="AlertVariant.Danger" TestId="offers-error">@_listNote</Alert>}

    @if (_confirm is { } confirm)
    {
        <section class="callout callout--warning" role="alertdialog" aria-labelledby="confirm-title" aria-describedby="confirm-body" data-testid="confirm-disable">
            <h2 id="confirm-title" class="callout__title">@string.Format(PlAgent.Offers.ConfirmTitle, confirm.Title)</h2>
            <p id="confirm-body">@PlAgent.Offers.ConfirmBody</p>
            <form method="post" @onsubmit="DisableAsync" @formname="offer-disable" class="cluster">
                <AntiforgeryToken />
                <input type="hidden" name="id" value="@confirm.Id" />
                <button class="btn btn--danger" type="submit">@PlAgent.Offers.ConfirmYes</button>
                <a class="btn btn--ghost" href="@At(AgentPaths.Offers)">@PlAgent.Offers.ConfirmNo</a>
            </form>
        </section>
    }

    <h2 id="offers-list-title">@PlAgent.Offers.ListLabel</h2>
    @if (_offers.Count == 0)
    {
        <p class="empty-state">@PlAgent.Offers.Empty</p>
    }
    else
    {
        <form method="post" @onsubmit="EnableAsync" @formname="offer-enable">
            <AntiforgeryToken />
            <ul class="stack offers" aria-labelledby="offers-list-title">
                @foreach (var o in _offers)
                {
                    <li class="card offer" data-testid="offer" data-active="@(o.IsActive ? "true" : "false")">
                        <div class="cluster cluster--between">
                            <h3 class="offer__title">@o.Title</h3>
                            <KindBadge Label="@(o.IsActive ? PlAgent.Offers.Active : PlAgent.Offers.Inactive)" Kind="@(o.IsActive ? "success" : "neutral")" />
                        </div>
                        <p class="muted"><span data-testid="offer-units">@Gabinety.Web.Components.Pages.Gabinet.Profile.UnitsLine(o.Kind, o.Units, o.DurationMinutes)</span> · <span class="num">@Money.Pln(o.Price.AmountMinor)</span></p>
                        <div class="cluster row-actions">
                            @if (o.IsActive)
                            {
                                <a class="btn btn--secondary" href="@At(AgentPaths.Offers, $"edit={o.Id}")" aria-label="@($"{PlAgent.Offers.Edit}: {o.Title}")">@PlAgent.Offers.Edit</a>
                                <a class="btn btn--ghost-danger" href="@At(AgentPaths.Offers, $"wylacz={o.Id}")" aria-label="@($"{PlAgent.Offers.Disable}: {o.Title}")">@PlAgent.Offers.Disable</a>
                            }
                            else
                            {
                                <button class="btn btn--secondary" type="submit" name="enable" value="@o.Id" aria-label="@($"{PlAgent.Offers.Enable}: {o.Title}")">@PlAgent.Offers.Enable</button>
                            }
                        </div>
                    </li>
                }
            </ul>
        </form>
    }

    @if (!_formOpen)
    {
        <div class="cluster section">
            @if (_active < OfferForm.MaxActive)
            {
                <a class="btn btn--primary" href="@At(AgentPaths.Offers, "nowa=1")">@PlAgent.Offers.AddNew</a>
            }
            else
            {
                <p class="muted">@PlAgent.Offers.TooMany</p>
            }
        </div>
    }
    else
    {
        <div class="offer-editor section">
            <section class="card offer-editor__form" aria-labelledby="offer-form-title">
                <h2 id="offer-form-title">@(_editing is null ? PlAgent.Offers.FormTitleNew : PlAgent.Offers.FormTitleEdit)</h2>
                @if (_editing is not null) {<p class="muted">@PlAgent.Offers.PriceChangeNote</p>}
                @if (_taxonomy is null) {<Alert Variant="AlertVariant.Danger" TestId="taxonomy-unavailable">@PlAgent.Offers.TaxonomyUnavailable</Alert>}
                <ErrorSummary Errors="Summary" />
                @if (_general is not null) {<Alert Variant="AlertVariant.Danger" TestId="offer-error">@_general</Alert>}
                <form method="post" @onsubmit="SaveAsync" @formname="offer" class="form stack form-narrow" novalidate>
                    <AntiforgeryToken />
                    <input type="hidden" name="id" value="@_editing" />
                    <FormField Id="title" Label="@PlAgent.Offers.Name" Hint="@PlAgent.Offers.NameHint" Error="@Error("title")" Max="80" Length="_f.Title.Length">
                        <input id="@context.Id" name="title" value="@_f.Title" maxlength="80" aria-describedby="@context.DescribedBy" aria-invalid="@Invalid(context)" />
                    </FormField>
                    <FormField Id="description" Label="@PlAgent.Offers.Description" Hint="@PlAgent.Offers.DescriptionHint" Error="@Error("description")" Max="600" Length="_f.Description.Length" Optional="true">
                        <textarea id="@context.Id" name="description" rows="5" maxlength="600" aria-describedby="@context.DescribedBy" aria-invalid="@Invalid(context)">@_f.Description</textarea>
                    </FormField>
                    <div class="offer-form__pair">
                        <FormField Id="kind" Label="@PlAgent.Offers.Kind" Hint="@PlAgent.Offers.KindHint" Error="@Error("kind")">
                            <select id="@context.Id" name="kind" aria-describedby="@context.DescribedBy" aria-invalid="@Invalid(context)">
                                <option value="Tasks" selected="@(_f.Kind != "Chat")">@PlAgent.Offers.KindTasks</option>
                                <option value="Chat" selected="@(_f.Kind == "Chat")">@PlAgent.Offers.KindChat</option>
                            </select>
                        </FormField>
                        <FormField Id="units" Label="@PlAgent.Offers.Units" Hint="@($"{PlAgent.Offers.UnitsHintTasks} {PlAgent.Offers.UnitsHintChat}")" Error="@Error("units")">
                            <input id="@context.Id" name="units" inputmode="numeric" autocomplete="off" value="@_f.Units" aria-describedby="@context.DescribedBy" aria-invalid="@Invalid(context)" />
                        </FormField>
                    </div>
                    <div class="offer-form__pair">
                        <FormField Id="duration" Label="@PlAgent.Offers.Duration" Error="@Error("durationMinutes")">
                            <select id="@context.Id" name="duration" aria-describedby="@context.DescribedBy" aria-invalid="@Invalid(context)">
                                <option value="30" selected="@(_f.Duration != "60")">@PlAgent.Offers.D30</option>
                                <option value="60" selected="@(_f.Duration == "60")">@PlAgent.Offers.D60</option>
                            </select>
                        </FormField>
                        <FormField Id="price" Label="@PlAgent.Offers.Price" Hint="@PlAgent.Offers.PriceHint" Error="@Error("priceMinor")">
                            <input id="@context.Id" name="price" inputmode="decimal" autocomplete="off" value="@_f.Price" aria-describedby="@context.DescribedBy" aria-invalid="@Invalid(context)" />
                        </FormField>
                    </div>
                    <FormField Id="problemSlug" Label="@PlAgent.Offers.Problem" Error="@Error("problemSlug")">
                        <select id="@context.Id" name="problemSlug" aria-describedby="@context.DescribedBy" aria-invalid="@Invalid(context)">
                            <option value="" selected="@(_f.Problem == "")">@PlAgent.Offers.Choose</option>
                            @foreach (var p in _taxonomy?.Problems ?? [])
                            {
                                <option value="@p.Slug" selected="@(_f.Problem == p.Slug)">@p.NamePl</option>
                            }
                        </select>
                    </FormField>
                    <fieldset class="option-group" id="techSlugs" aria-describedby="@(Error("techSlugs") is null ? "techs-hint techs-count" : "techs-hint techs-count techSlugs-error")">
                        <legend>@PlAgent.Offers.Techs</legend>
                        <p class="field__hint" id="techs-hint">@PlAgent.Offers.TechsHint</p>
                        <div class="cluster chips">
                            @foreach (var t in _taxonomy?.Techs ?? [])
                            {
                                <label class="option chip"><input type="checkbox" name="techs" value="@t.Slug" checked="@_f.Techs.Contains(t.Slug)" /> @t.NamePl</label>
                            }
                        </div>
                        <p class="muted" id="techs-count">@string.Format(PlAgent.Offers.TechCount, _f.Techs.Count)</p>
                        @if (Error("techSlugs") is { } techError) {<p class="field__error" id="techSlugs-error"><span class="visually-hidden">@($"{PlAgent.Common.ErrorWord} ")</span>@techError</p>}
                    </fieldset>
                    <div class="form-actions cluster">
                        <button class="btn btn--primary" type="submit" disabled="@(_editing is null && _active >= OfferForm.MaxActive)">@PlAgent.Common.Save</button>
                        <a class="btn btn--ghost" href="@At(AgentPaths.Offers)">@PlAgent.Offers.Cancel</a>
                    </div>
                    @if (_editing is null && _active >= OfferForm.MaxActive) {<p class="muted">@PlAgent.Offers.TooMany</p>}
                </form>
            </section>

            @* The card a client sees on the profile, from the values in the form (saved values when editing, placeholders when creating). Static: it does not need JavaScript. *@
            <section class="card offer-preview" aria-labelledby="offer-preview-title">
                <h2 id="offer-preview-title" class="offer-preview__label">@PlAgent.Offers.PreviewLabel</h2>
                <p class="muted offer-preview__note">@PlAgent.Offers.PreviewNote</p>
                <h3 class="offer-preview__title @(string.IsNullOrWhiteSpace(_f.Title) ? "muted" : null)">@(string.IsNullOrWhiteSpace(_f.Title) ? PlAgent.Offers.PreviewTitle : _f.Title)</h3>
                <p class="offer-preview__desc @(string.IsNullOrWhiteSpace(_f.Description) ? "muted" : null)">@(string.IsNullOrWhiteSpace(_f.Description) ? PlAgent.Offers.PreviewDescription : _f.Description)</p>
                <p class="cluster offer-preview__meta"><span>@PreviewUnits</span> · <span class="num @(PreviewPriceIsPlaceholder ? "muted" : null)">@PreviewPrice</span></p>
            </section>
        </div>
    }
}

@code {
    /// <summary><c>?edit=&lt;id&gt;</c>: the offer in the form. <c>?wylacz=&lt;id&gt;</c>: the confirmation of disabling it. <c>?nowa=1</c>: the form for a new offer. Both ids are looked up in the practitioner's own list; an unknown id shows nothing.</summary>
    [SupplyParameterFromQuery(Name = "edit")] public Guid? EditId { get; set; }
    [SupplyParameterFromQuery(Name = "wylacz")] public Guid? DisableId { get; set; }
    [SupplyParameterFromQuery(Name = "nowa")] public string? NewParam { get; set; }

    IReadOnlyList<PackagePrivateDto> _offers = [];
    TaxonomyDto? _taxonomy;
    OfferForm _f = OfferForm.Empty;
    PackagePrivateDto? _confirm;
    Guid? _editing;
    int _active;
    bool _loaded, _formOpen;
    string? _general, _listNote;
    readonly Dictionary<string, string> _errors = [];

    string? Error(string field) => _errors.GetValueOrDefault(field);
    static string? Invalid(FormField.FieldContext c) => c.Invalid ? "true" : null;

    IReadOnlyList<KeyValuePair<string, string>> Summary => [.. OfferForm.FieldOrder.Where(_errors.ContainsKey).Select(f => KeyValuePair.Create(OfferForm.IdOf(f), _errors[f]))];

    /// <summary>The price as the card shows it, or the placeholder while the typed text is not a valid price.</summary>
    (string Text, bool IsPlaceholder) Preview()
    {
        var (problem, grosz) = PriceInput.Parse(_f.Price);
        return problem == PriceProblem.None ? (Money.Pln(grosz), false) : (PlAgent.Offers.PreviewPrice, true);
    }
    string PreviewUnits => int.TryParse(_f.Units, out var units) && units > 0 ? Gabinety.Web.Components.Pages.Gabinet.Profile.UnitsLine(_f.Kind, units, _f.Duration == "60" ? 60 : 30) : string.Format(PlAgent.Offers.Minutes, _f.Duration == "60" ? 60 : 30);
    string PreviewPrice => Preview().Text;
    bool PreviewPriceIsPlaceholder => Preview().IsPlaceholder;

    protected override async Task OnInitializedAsync()
    {
        if (!await LoadProfileAsync()) return;
        var offers = Agent.PackagesAsync();
        var taxonomy = Directory.TaxonomyAsync();
        await Task.WhenAll(offers, taxonomy);
        if (!offers.Result.IsOk) { LoadFailure = offers.Result.Failure; return; }
        _offers = offers.Result.Value!;
        _taxonomy = taxonomy.Result.Value;
        _active = _offers.Count(o => o.IsActive);
        _confirm = DisableId is { } d ? _offers.FirstOrDefault(o => o.Id == d && o.IsActive) : null;
        _formOpen = NewParam is "1" or "true" || EditId is not null;
        if (EditId is { } e && _offers.FirstOrDefault(o => o.Id == e && o.IsActive) is { } mine) { _editing = mine.Id; _f = OfferForm.From(mine); }
        _loaded = true;
    }

    async Task Reload()
    {
        var r = await Agent.PackagesAsync();
        if (r.IsOk) { _offers = r.Value!; _active = _offers.Count(o => o.IsActive); }
    }

    async Task SaveAsync()
    {
        _formOpen = true; // a posted form is shown again with its errors, whatever the URL said
        _f = OfferForm.FromPosted(Posted);
        _editing = Guid.TryParse(Posted.Get("id"), out var id) && _offers.Any(o => o.Id == id) ? id : null; // only an offer of this practitioner
        var local = _f.Validate();
        if (local.Count > 0) { foreach (var (field, message) in local) _errors[field] = message; return; }
        var r = await Agent.SavePackageAsync(_editing, _f.ToBody());
        if (r.IsOk) { Done(AgentPaths.Offers, FlashKey.Saved); return; }
        foreach (var (field, message) in FieldErrors.From(r.Failure!, new Dictionary<string, string?> { ["title"] = _f.Title, ["description"] = _f.Description })) _errors[field] = message;
        if (r.Failure!.Code == "too_many_offerings") _general = PlAgent.Offers.TooMany;
        else if (_errors.Count == 0) _general = FieldErrors.General(r.Failure, PlAgent.Offers.Failed);
    }

    async Task DisableAsync()
    {
        if (!Guid.TryParse(Posted.Get("id"), out var id) || !_offers.Any(o => o.Id == id)) { _listNote = PlAgent.Offers.NotFound; return; }
        var r = await Agent.DeactivatePackageAsync(id);
        if (r.IsOk) { Done(AgentPaths.Offers, FlashKey.OfferDisabled); return; }
        _listNote = FieldErrors.General(r.Failure!, PlAgent.Offers.Failed);
    }

    async Task EnableAsync()
    {
        if (!Guid.TryParse(Posted.Get("enable"), out var id) || !_offers.Any(o => o.Id == id)) { _listNote = PlAgent.Offers.NotFound; return; }
        var r = await Agent.ActivatePackageAsync(id);
        if (r.IsOk) { Done(AgentPaths.Offers, FlashKey.OfferEnabled); return; }
        _listNote = r.Failure!.Code == "too_many_offerings" ? PlAgent.Offers.TooMany : FieldErrors.General(r.Failure, PlAgent.Offers.Failed);
        await Reload();
    }
}
