@page "/dostep/potwierdzenie/{BookingId:guid}"
@attribute [Authorize]
@inject BookingClient Accesses
@inject NavigationManager Navigation
@inject TimeProvider Time
@inject Gabinety.Web.Hosting.WebOptions Site
@* Success is claimed only for a package the server reports as Confirmed. A payment that is still being confirmed (the provider's notification has not arrived) says so and reloads itself while the hold lasts:
   a meta refresh, no script. A 429/503 shows "Odśwież stronę" with the link that does it. The next steps depend on the kind: a chat package is connected by API, a task package starts with a task. *@

<PageTitle>@BookFlowText.Confirmation.MetaTitle</PageTitle>
<HeadContent>
    <meta name="robots" content="noindex,follow" />
    @if (_refreshSeconds is { } seconds) {<meta http-equiv="refresh" content="@seconds" />}
</HeadContent>
<h1>@(_booking?.Status == "Confirmed" ? BookFlowText.Confirmation.ConfirmedTitle : BookFlowText.Confirmation.Title)</h1>

@if (_failure is not null)
{
    <div class="callout callout--danger" role="alert" data-testid="unavailable">
        <p>@BookFlowText.Checkout.LoadFailed</p>
        <a class="btn btn--secondary" href="@CurrentPath">@BookFlowText.Checkout.Refresh</a>
    </div>
}
else if (_booking is { } b)
{
    var confirmed = b.Status == "Confirmed";
    <BookingSteps Current="2" />
    <div class="stack booking-confirmation">
        @if (confirmed) {<div class="callout callout--success" role="status">@BookFlowText.Confirmation.Confirmed</div>}
        else if (b.Status == "PendingPayment") {<div class="callout callout--info" role="status">@BookFlowText.Confirmation.Pending <a href="@CurrentPath">@BookFlowText.Confirmation.Refresh</a></div>}
        else {<div class="callout callout--warning" role="status">@BookFlowText.Confirmation.Other</div>}
        <ConsultationSummary Package="@b.PackageTitle" Party="@BookingFormat.Name(b.Agent.DisplayName)" Units="@BookingFormat.UnitsLine(b.Kind, b.UnitsTotal)"
                             Validity="@string.Format(BookFlowText.Summary.ValidUntil, BookingFormat.ValidUntil(b.EndUtc))" PriceMinor="b.Price.AmountMinor">
            <p class="muted" data-testid="confirmation-state">@BookFlowText.Confirmation.State: <BookingBadge Badge="Badge.ForBooking(b.Status)" /></p>
        </ConsultationSummary>
        @if (confirmed)
        {
            <section class="card booking-confirmation__next" aria-labelledby="next-steps-title">
                <h2 id="next-steps-title">@BookFlowText.Confirmation.NextTitle</h2>
                <ul class="booking-confirmation__list">
                    <li>@BookFlowText.Confirmation.NextEmail</li>
                    <li>@BookFlowText.Confirmation.NextCancel <a href="/cennik">@BookFlowText.Confirmation.NextCancelLink</a>.</li>
                </ul>
                @if (b.Kind == "Chat")
                {
                    <div data-testid="connect">
                        <h3>@BookFlowText.Confirmation.ConnectTitle</h3>
                        <dl class="dl">
                            <dt>@BookFlowText.Confirmation.ConnectBaseUrl</dt><dd><code data-testid="connect-base-url">@Site.ApiBaseUrl</code></dd>
                            <dt>@BookFlowText.Confirmation.ConnectModel</dt><dd><code data-testid="connect-model">@b.Agent.Slug</code></dd>
                        </dl>
                        <p class="muted">@BookFlowText.Confirmation.ConnectHint</p>
                    </div>
                }
            </section>
        }
        <div class="form-actions">
            @if (confirmed && b.Kind != "Chat") {<a class="btn btn--primary" href="@($"/moje/dostepy/{b.Id}?role=client#zadania")" data-testid="first-task">@BookFlowText.Confirmation.FirstTask</a>}
            @if (confirmed) {<a class="btn btn--primary" href="/moje/klucze" data-testid="create-key">@BookFlowText.Confirmation.CreateKey</a>}
            <a class="btn btn--secondary" href="@($"/moje/dostepy/{b.Id}?role=client")">@BookFlowText.Confirmation.View</a>
            <a class="btn btn--secondary" href="/agenci">@BookFlowText.Confirmation.ToSearch</a>
        </div>
    </div>
}

@code {
    [Parameter] public Guid BookingId { get; set; }

    BookingDetailDto? _booking;
    ApiFailure? _failure;
    int? _refreshSeconds;

    string CurrentPath => "/" + Navigation.ToBaseRelativePath(Navigation.Uri);

    protected override async Task OnInitializedAsync()
    {
        var result = await Accesses.GetAsync(BookingId);
        if (!result.IsOk)
        {
            if (result.Failure!.IsUnauthenticated) { Navigation.NavigateTo(ReturnTarget.LoginUrl(ReturnTarget.Safe(CurrentPath))); return; }
            if (result.Failure.Status is 404 or 403) { Navigation.NotFound(); return; }
            _failure = result.Failure;
            return;
        }
        _booking = result.Value;
        if (_booking!.Status == "PendingPayment" && (_booking.HoldExpiresAt is not { } hold || hold > Time.GetUtcNow())) _refreshSeconds = 5;
    }
}
