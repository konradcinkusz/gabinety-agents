@page "/moje/dostepy/{BookingId:guid}"
@attribute [Authorize]
@using Gabinety.Web.Components.Pages.Shared
@inject AccessClient Accesses
@inject NavigationManager Navigation
@inject TimeProvider Clock
@* Static server rendering. Every action is driven ONLY by the server's can* flags: the windows are never recomputed here. An action opens as a state of the page (?action=), shown as a
   native dialog that is open in the markup (no script): a GET form's button opens it, a POST form confirms it, and the result is a redirect with a fixed key (?done=), so a reload never repeats it.
   The texts of users (the cancel reason, the dispute) are request bodies only: never logged, never echoed into a URL. *@

<PageTitle>@AccessesText.DetailMetaTitle</PageTitle>
<HeadContent>
    <meta name="robots" content="noindex,follow" />
</HeadContent>
<h1>@AccessesText.DetailTitle</h1>

@if (_failure is not null)
{
    <div class="callout callout--danger" role="alert" data-testid="unavailable">
        <p>@ActionFailure.Text(_failure)</p>
        <a class="btn btn--secondary" href="@DetailHref()">@AccessesText.ReloadHint</a>
    </div>
}
else if (_booking is { } b)
{
    <div class="stack">
        @if (DoneText is { } done) {<div class="callout callout--success" role="status" data-testid="done">@done</div>}
        <section class="card" aria-labelledby="booking-title">
            <h2 id="booking-title">@b.PackageTitle</h2>
            @if (b.Status == "Confirmed")
            {
                <div class="head" data-testid="booking-head">
                    <p class="head__when">@string.Format(AccessesText.Detail.ActiveLine, AccessFormat.ValidUntil(b.EndUtc))</p>
                </div>
            }
            else if (b.Status == "Completed")
            {
                <div class="head" data-testid="booking-head">
                    <p class="head__when">@AccessesText.Detail.CompletedLine</p>
                    @if (b.CanReview) {<div class="form-actions"><a class="btn btn--primary" href="@($"/moje/opinie/{b.Id}")">@AccessesText.Review</a></div>}
                </div>
            }
            else if (AccessFormat.IsCancelled(b.Status) && RefundLine(b) is { } refundLine)
            {
                <p class="callout callout--info" data-testid="booking-head">@refundLine</p>
            }
            <dl class="dl">
                @if (AccessFormat.Name(_role == AccessClient.ClientRole ? b.Agent.DisplayName : b.Client?.DisplayName) is { } party)
                {
                    <dt>@(_role == AccessClient.ClientRole ? AccessesText.PartyAgent : AccessesText.PartyClient)</dt><dd>@party @if (_role == AccessClient.ClientRole) {<AiBadge />}</dd>
                }
                <dt>@AccessesText.Detail.Units</dt><dd data-testid="detail-units">@AccessFormat.UnitsLine(b.Kind, b.UnitsTotal)</dd>
                <dt>@AccessesText.Detail.Usage</dt><dd><UsageBar Kind="@b.Kind" Used="b.UnitsUsed" Total="b.UnitsTotal" /></dd>
                <dt>@AccessesText.Detail.ValidUntil</dt><dd data-testid="detail-valid-until">@AccessFormat.ValidUntil(b.EndUtc)</dd>
                <dt>@AccessesText.Detail.Status</dt><dd><AccessBadge Badge="Badge.ForAccess(b.Status)" /></dd>
                <dt>@AccessesText.Detail.Price</dt><dd class="num">@Money.Pln(b.Price.AmountMinor)</dd>
                <dt>@AccessesText.Detail.Payment</dt>
                <dd>
                    <AccessBadge Badge="Badge.ForPayment(b.Payment.Status)" />
                    @if (b.Payment.Refunded.AmountMinor > 0) {<span class="num refund-line">@string.Format(AccessesText.Detail.Refunded, Money.Pln(b.Payment.Refunded.AmountMinor))</span>}
                </dd>
                @if (b.Fee is { } fee) {<dt>@AccessesText.Detail.Fee</dt><dd class="num">@Money.Pln(fee.AmountMinor)</dd>}
                @if (b.Payout is { } payout) {<dt>@AccessesText.Detail.Payout</dt><dd class="num">@Money.Pln(payout.AmountMinor)</dd>}
            </dl>
        </section>

        @if (b.Brief is { } brief)
        {
            <section class="card" aria-labelledby="brief-title">
                <h2 id="brief-title">@(_role == AccessClient.ClientRole ? AccessesText.Detail.BriefOwn : AccessesText.Detail.Brief)</h2>
                <p class="brief">@brief.Text</p>
            </section>
        }

        @if (Open == "cancel" && b.CanCancel)
        {
            <dialog open data-enhance="dialog" role="alertdialog" aria-labelledby="cancel-title" class="dialog" data-testid="cancel-dialog">
                <h2 id="cancel-title" tabindex="-1" autofocus>@AccessesText.Cancel.Title</h2>
                <p class="@(CancelOutcome.Warns(_outcome, _role) ? "callout callout--danger" : "callout callout--info")">@CancelOutcome.Sentence(_outcome, _role)</p>
                <form method="post" @onsubmit="CancelAsync" @formname="cancel" class="form" novalidate>
                    <AntiforgeryToken />
                    <AccessFormProblems Items="_problems" />
                    <CounterTextArea Id="reason" Name="Model.Reason" Label="@AccessesText.Cancel.ReasonLabel" Hint="@AccessesText.Cancel.ReasonHint" Value="@CancelModel!.Reason" Rows="3" Error="@_reasonError" />
                    <ActionError Failure="_actionFailure" Href="@DetailHref()" />
                    <div class="form-actions">
                        <button type="submit" class="btn btn--danger">@AccessesText.Cancel.Confirm</button>
                        <a class="btn btn--secondary" href="@DetailHref()" data-dialog-dismiss>@AccessesText.Cancel.Keep</a>
                    </div>
                </form>
            </dialog>
        }
        else if (Open == "dispute" && b.CanDispute)
        {
            <dialog open data-enhance="dialog" role="alertdialog" aria-labelledby="dispute-title" class="dialog" data-testid="dispute-form">
                <h2 id="dispute-title" tabindex="-1">@AccessesText.Dispute.Title</h2>
                <p>@AccessesText.Dispute.Intro</p>
                <form method="post" @onsubmit="DisputeAsync" @formname="dispute" class="form" novalidate>
                    <AntiforgeryToken />
                    <AccessFormProblems Items="_problems" />
                    <div class="field">
                        <label class="field__label" for="kind">@AccessesText.Dispute.KindLabel</label>
                        <select id="kind" name="Model.Kind" class="field__control">
                            @foreach (var k in DisputeRules.Kinds) {<option value="@k" selected="@(k == (DisputeModel!.Kind ?? DisputeRules.Kinds[0]))">@DisputeRules.KindLabel(k)</option>}
                        </select>
                    </div>
                    <CounterTextArea Id="text" Name="Model.Text" Label="@AccessesText.Dispute.TextLabel" Hint="@AccessesText.Dispute.TextHint" Value="@DisputeModel!.Text" Rows="5"
                                     CounterFormat="@AccessesText.Dispute.Counter" Error="@_textError" Autofocus="@(_problems.Count == 1)" />
                    <ActionError Failure="_actionFailure" Href="@DetailHref()" />
                    <div class="form-actions">
                        <button type="submit" class="btn btn--primary">@AccessesText.Dispute.Submit</button>
                        <a class="btn btn--ghost" href="@DetailHref()" data-dialog-dismiss>@AccessesText.Dispute.Close</a>
                    </div>
                </form>
            </dialog>
        }
        else
        {
            <div class="form-actions">
                @if (b.CanReview && b.Status != "Completed") {<a class="btn btn--primary" href="@($"/moje/opinie/{b.Id}")">@AccessesText.Review</a>}
                @if (_role == AccessClient.ClientRole && AccessFormat.RebookHref(b.Status, b.Agent.Slug) is { } rebook) {<a class="btn btn--secondary" href="@rebook">@AccessesText.Detail.Rebook</a>}
                @if (b.CanCancel || b.CanDispute)
                {
                    @* a GET form: the buttons open the action without a script and without a state change (a link would not be a button) *@
                    <form method="get" action="@DetailPath" class="cluster">
                        <input type="hidden" name="role" value="@_role" />
                        @if (b.CanDispute) {<button type="submit" name="action" value="dispute" class="btn btn--secondary">@AccessesText.Actions.Dispute</button>}
                        @if (b.CanCancel) {<button type="submit" name="action" value="cancel" class="btn btn--ghost-danger">@AccessesText.Actions.Cancel</button>}
                    </form>
                }
            </div>
        }
        @if (b.Kind != "Chat" && _role == AccessClient.ClientRole)
        {
            <section class="card stack" aria-labelledby="tasks-title" id="zadania" data-testid="tasks">
                <h2 id="tasks-title">@AccessesText.Tasks.Title</h2>
                @if (b.Status == "Confirmed" && b.UnitsUsed < b.UnitsTotal)
                {
                    <form method="post" @onsubmit="CreateTaskAsync" @formname="task" class="form" novalidate>
                        <AntiforgeryToken />
                        <h3>@AccessesText.Tasks.FormTitle</h3>
                        <AccessFormProblems Items="_taskProblems" />
                        <CounterTextArea Id="task-input" Name="Model.Input" Label="@AccessesText.Tasks.InputLabel" Hint="@AccessesText.Tasks.InputHint" Value="@TaskModel!.Input" Rows="6"
                                         CounterFormat="@AccessesText.Tasks.Counter" Error="@_taskError" />
                        <ActionError Failure="_taskFailure" Href="@DetailHref()" />
                        <div class="form-actions"><button type="submit" class="btn btn--primary">@AccessesText.Tasks.Submit</button></div>
                    </form>
                }
                else
                {
                    <p class="muted" data-testid="task-not-active">@AccessesText.Tasks.NotActive</p>
                }
                <h3>@AccessesText.Tasks.ListTitle</h3>
                @if (_tasksFailed)
                {
                    <div class="callout callout--warning" role="status" data-testid="tasks-unavailable"><p>@AccessesText.Tasks.Unavailable</p><a class="btn btn--secondary" href="@DetailHref()">@AccessesText.Tasks.Refresh</a></div>
                }
                else if (_tasks.Count == 0)
                {
                    <p data-testid="tasks-empty">@AccessesText.Tasks.Empty</p>
                }
                else
                {
                    <ul class="stack tasks" aria-label="@AccessesText.Tasks.ListLabel">
                        @foreach (var t in _tasks)
                        {
                            <li class="card" data-testid="task-row">
                                <p class="cluster">
                                    <span class="badge @TaskBadge(t.Status)" data-testid="task-status">@TaskStatusLabel(t.Status)</span>
                                    <span class="muted">@string.Format(AccessesText.Tasks.Created, PlFormat.DayLong(t.CreatedAt))@if (t.CompletedAt is { } finished) {<text>, @string.Format(AccessesText.Tasks.Completed, PlFormat.DayLong(finished))</text>}</span>
                                </p>
                                @if (!string.IsNullOrEmpty(t.Output))
                                {
                                    @* the agent's text: encoded text in a pre-wrapped block, never markup *@
                                    <p class="muted">@AccessesText.Tasks.Result</p>
                                    <p class="task-output" data-testid="task-output">@t.Output</p>
                                }
                            </li>
                        }
                    </ul>
                    @if (_tasks.Any(t => t.Status is "queued" or "running"))
                    {
                        <p class="muted" role="status">@AccessesText.Tasks.Pending <a href="@DetailHref()">@AccessesText.Tasks.Refresh</a></p>
                    }
                }
            </section>
        }
        <p><a href="/moje/dostepy?role=@_role">@AccessesText.Back</a></p>
    </div>
}

@code {
    [Parameter] public Guid BookingId { get; set; }
    [SupplyParameterFromQuery(Name = "role")] public string? RoleParam { get; set; }
    [SupplyParameterFromQuery(Name = "action")] public string? ActionParam { get; set; }
    [SupplyParameterFromQuery(Name = "done")] public string? DoneParam { get; set; }
    [SupplyParameterFromForm(FormName = "cancel", Name = "Model")] CancelForm? CancelModel { get; set; }
    [SupplyParameterFromForm(FormName = "dispute", Name = "Model")] DisputeForm? DisputeModel { get; set; }
    [SupplyParameterFromForm(FormName = "task", Name = "Model")] TaskForm? TaskModel { get; set; }

    public sealed class CancelForm { public string? Reason { get; set; } }
    public sealed class DisputeForm { public string? Kind { get; set; } public string? Text { get; set; } }
    public sealed class TaskForm { public string? Input { get; set; } }

    /// <summary>The path the action buttons post back to (a GET form: the query is replaced by the form's own fields).</summary>
    string DetailPath => $"/moje/dostepy/{BookingId}";

    AccessDetailDto? _booking;
    ApiFailure? _failure, _actionFailure;
    CancelOutcome? _outcome;
    string _role = AccessClient.ClientRole;
    string? _textError, _reasonError, _taskError;
    IReadOnlyList<AgentTaskDto> _tasks = [];
    bool _tasksFailed;
    ApiFailure? _taskFailure;
    List<FormProblem> _taskProblems = [];
    List<FormProblem> _problems = [];

    /// <summary>What happens to the money of a cancelled booking, from the payment view only: the refund when there is one; "bez zwrotu" only for the late cancellation the status itself names.</summary>
    static string? RefundLine(AccessDetailDto b) =>
        b.Payment.Refunded.AmountMinor > 0 ? string.Format(AccessesText.Detail.RefundLine, Money.Pln(b.Payment.Refunded.AmountMinor))
        : b.Status == "LateCancelledByClient" ? AccessesText.Detail.NoRefundLine : null;

    string? Open => ActionParam is "cancel" or "dispute" ? ActionParam : null;

    string? DoneText => DoneParam switch
    {
        "cancelled" => AccessesText.Cancel.Done,
        "disputed" => AccessesText.Dispute.Done,
        "task" => AccessesText.Tasks.Done,
        _ => null,
    };

    string DetailHref(string? action = null, string? done = null) =>
        $"/moje/dostepy/{BookingId}?role={_role}" + (action is null ? "" : "&action=" + action) + (done is null ? "" : "&done=" + done);

    protected override async Task OnInitializedAsync()
    {
        CancelModel ??= new();
        DisputeModel ??= new();
        TaskModel ??= new();
        _role = AccessFormat.Role(RoleParam);
        var result = await Accesses.GetAsync(BookingId);
        if (result.IsOk)
        {
            _booking = result.Value;
            _outcome = CancelOutcome.From(_booking!.CancelOutcome, _booking.Price);
            if (_booking.Kind != "Chat" && _role == AccessClient.ClientRole) await LoadTasksAsync();
            return;
        }
        if (result.Failure!.IsUnauthenticated) { SignIn(); return; }
        if (result.Failure.Status is 404 or 403) { Navigation.NotFound(); return; } // not this user's booking: the answer of an unknown id
        _failure = result.Failure;
    }

    async Task LoadTasksAsync()
    {
        var result = await Accesses.TasksAsync(BookingId);
        if (result.IsOk) { _tasks = [.. result.Value!.OrderByDescending(t => t.CreatedAt)]; _tasksFailed = false; }
        else { _tasks = []; _tasksFailed = true; }
    }

    static string TaskStatusLabel(string status) => AccessesText.Tasks.Statuses.TryGetValue(status.ToLowerInvariant(), out var label) ? label : AccessesText.Tasks.UnknownStatus;

    static string TaskBadge(string status) => status.ToLowerInvariant() switch { "succeeded" => "badge--success", "failed" => "badge--danger", "running" => "badge--info", _ => "badge--neutral" };

    /// <summary>The task text is checked first (20 to 20000 characters) so every problem is shown at once; it is user text: sent as a body, never logged.</summary>
    async Task CreateTaskAsync()
    {
        var length = (TaskModel!.Input ?? "").Trim().Length;
        _taskError = length < 20 ? AccessesText.Tasks.TooShort : length > 20000 ? AccessesText.Tasks.TooLong : null;
        _taskProblems = _taskError is null ? [] : [new FormProblem("task-input", _taskError)];
        if (_taskError is not null) return;
        var result = await Accesses.CreateTaskAsync(BookingId, TaskModel.Input!);
        if (result.IsOk) { Navigation.NavigateTo(DetailHref(done: "task") + "#zadania"); return; } // a redirect with a fixed key: a reload never orders the task twice
        if (result.Failure!.IsUnauthenticated) { SignIn(); return; }
        _taskFailure = result.Failure;
    }

    void SignIn() => Navigation.NavigateTo(ReturnTarget.LoginUrl(ReturnTarget.Safe(DetailHref())));

    Task CancelAsync()
    {
        _reasonError = DisputeRules.ReasonProblem(CancelModel!.Reason);
        _problems = _reasonError is null ? [] : [new FormProblem("reason", _reasonError)];
        return _reasonError is not null ? Task.CompletedTask : RunAsync(() => Accesses.CancelAsync(BookingId, CancelModel.Reason), "cancelled", "cancel");
    }

    Task DisputeAsync()
    {
        DisputeModel!.Kind ??= DisputeRules.Kinds[0];
        var problems = new List<FormProblem>();
        if (DisputeRules.KindProblem(DisputeModel.Kind) is { } kind) problems.Add(new("kind", kind));
        _textError = DisputeRules.TextProblem(DisputeModel.Text);
        if (_textError is not null) problems.Add(new("text", _textError));
        _problems = problems;
        return problems.Count > 0 ? Task.CompletedTask : RunAsync(() => Accesses.DisputeAsync(BookingId, DisputeModel.Kind!, DisputeModel.Text!), "disputed", "dispute");
    }


    /// <summary>Runs one action: success is a redirect with a fixed key; a failure is kept for display next to the form; a 401 goes to sign-in.</summary>
    async Task RunAsync(Func<Task<ApiResult<AccessDetailDto>>> call, string done, string action)
    {
        var result = await call();
        if (result.IsOk) { Navigation.NavigateTo(DetailHref(done: done)); return; }
        if (result.Failure!.IsUnauthenticated) { SignIn(); return; }
        _actionFailure = result.Failure;
        // the field the server named is shown under that field as well, in our words
        if (result.Failure.Names("text")) { _textError = AccessesText.Dispute.TooShort; _problems = [new FormProblem("text", _textError)]; }
        if (result.Failure.Names("reason")) { _reasonError = AccessesText.Cancel.ReasonTooLong; _problems = [new FormProblem("reason", _reasonError)]; }
    }
}
