@page "/gabinet/{Slug}"
@attribute [AllowAnonymous]
@attribute [Microsoft.AspNetCore.OutputCaching.OutputCache(PolicyName = Gabinety.Web.Hosting.PublicPageCachePolicy.Name)]
@inject DirectoryClient Directory
@inject ReputationClient Reputation
@inject NavigationManager Navigation
@inject Gabinety.Web.Hosting.WebOptions Site
@* Static server rendering: everything, the packages and the reviews included, is in the first response (J1 asserts the JSON-LD; a crawler gets the content without scripts). *@

@if (_profile is { } p)
{
    <PageMeta Title="@string.Format(PlPages.Profile.MetaTitle, p.DisplayName)" Description="@string.Format(PlPages.Profile.MetaDescription, p.DisplayName, p.Headline)" Path="@($"/gabinet/{Uri.EscapeDataString(p.Slug)}")" Type="profile" Robots="index,follow">
        <script type="application/ld+json">@((MarkupString)ProfileJsonLd.Build(p, Site.SiteBaseUrl + $"/gabinet/{Uri.EscapeDataString(p.Slug)}"))</script>
    </PageMeta>
    var portfolio = ProfileJsonLd.SafeHttps(p.PortfolioUrl);
    var checks = p.Badges.Where(b => b != "approved").ToList();
    <header class="page-header">
        <div class="identity">
            <Avatar Name="@p.DisplayName" Size="Avatar.AvatarSize.Large" />
            <div class="identity__text">
                <h1>@p.DisplayName</h1>
                <p><AiBadge /></p>
                <p class="lead">@p.Headline</p>
            </div>
        </div>
        <ul class="cluster" aria-label="@PlPages.Profile.BadgesLabel">
            @if (p.Badges.Contains("approved"))
            {
                <li><span class="badge badge--success" title="@PlPages.Profile.ApprovedInfo" aria-label="@($"{PlPages.Profile.Approved}. {PlPages.Profile.ApprovedInfo}")">@PlPages.Profile.Approved</span></li>
            }
            <li>
                @if (p.Rating is { } rating && !p.IsNew) {<span class="rating">@string.Format(PlPages.Profile.RatingShort, PlFormat.Rating(rating.Average), rating.Count)</span>}
                else {<span class="badge">@PlPages.Profile.IsNew</span>}
            </li>
        </ul>
        @if (checks.Count > 0)
        {
            <details class="checks">
                <summary>@PlPages.Profile.ChecksTitle</summary>
                <ul>
                    @foreach (var b in checks)
                    {
                        <li><strong>@BadgeLabel(b)</strong> <span class="muted">@BadgeInfo(b)</span></li>
                    }
                </ul>
            </details>
        }
        <ul class="facts muted" aria-label="@PlPages.Profile.FactsLabel">
            <li>@string.Format(PlPages.Profile.Completed, p.CompletedCount)</li>
            <li>@string.Format(PlPages.Profile.MemberSince, PlFormat.MonthYearGenitive(p.MemberSince))</li>
        </ul>
        @if (portfolio is not null || p.GithubLogin is { Length: > 0 })
        {
            <ul class="cluster profile-links" aria-label="@PlPages.Profile.LinksLabel">
                @if (portfolio is not null) {<li><a class="link" href="@portfolio" rel="noopener nofollow ugc">@PlPages.Profile.Portfolio</a></li>}
                @if (p.GithubLogin is { Length: > 0 } login) {<li><a class="link" href="@ProfileJsonLd.Github(login)" rel="noopener nofollow">@PlPages.Profile.Github</a></li>}
            </ul>
        }
    </header>

    <div class="layout">
    <div class="layout__main">
    <section class="section" aria-labelledby="about">
        <h2 id="about">@PlPages.Profile.AboutTitle</h2>
        <p class="bio">@p.Bio</p>
    </section>

    <section class="section" aria-labelledby="offerings">
        <h2 id="offerings">@PlPages.Profile.OfferingsTitle</h2>
        @if (p.Offerings.Count == 0)
        {
            <p data-testid="no-offerings">@PlPages.Profile.NoOfferings</p>
        }
        else
        {
            <ul class="offerings">
                @foreach (var o in p.Offerings)
                {
                    <li id="@($"oferta-{o.Id}")">
                        <div class="card">
                            <h3>@o.Title</h3>
                            <p class="description">@o.Description</p>
                            @if (TechNames(o) is { Count: > 0 } techs)
                            {
                                <ul class="cluster tags" aria-label="@PlPages.Profile.TechLabel">@foreach (var t in techs) {<li><span class="badge badge--neutral">@t</span></li>}</ul>
                            }
                            <p class="cluster"><span data-testid="offering-units">@UnitsLine(o)</span><span class="num price">@Money.Pln(o.Price.AmountMinor)</span></p>
                            <p class="muted" data-testid="offering-validity">@string.Format(PlPages.Profile.ValidityLine, PlPages.Profile.ValidityDays)</p>
                            <a class="btn btn--primary" href="@BookHref(p.Slug, o)" aria-label="@string.Format(PlPages.Profile.BookOffering, o.Title)">@PlPages.Profile.Book</a>
                        </div>
                    </li>
                }
            </ul>
        }
    </section>

    <section class="section" id="polacz" aria-labelledby="connect-title" data-testid="connect">
        <h2 id="connect-title">@PlPages.Profile.ConnectTitle</h2>
        <p>@PlPages.Profile.ConnectIntro</p>
        <dl class="connect">
            <dt>@PlPages.Profile.ConnectBaseUrl</dt><dd><code data-testid="connect-base-url">@Site.ApiBaseUrl</code></dd>
            <dt>@PlPages.Profile.ConnectModel</dt><dd><code data-testid="connect-model">@p.Slug</code></dd>
        </dl>
        <p class="muted">@PlPages.Profile.ConnectExample</p>
        <pre class="connect__code" data-testid="connect-curl"><code>@CurlExample(p.Slug)</code></pre>
    </section>

    <section class="section" id="opinie" aria-labelledby="reviews-title">
        <h2 id="reviews-title">@PlPages.Profile.ReviewsTitle</h2>
        @if (_reviews is null)
        {
            <Alert Variant="AlertVariant.Warning" TestId="reviews-unavailable">@PlPages.Profile.ReviewsUnavailable</Alert>
            <a class="btn" href="@($"/gabinet/{Uri.EscapeDataString(p.Slug)}#opinie")">@PlPages.Profile.Retry</a>
        }
        else if (_reviews.Items.Count == 0 && ReviewCursor is null)
        {
            @* One sentence, not two (P-PROF-1): a new practitioner and an established one with no reviews yet each say one thing. *@
            <p>@(p.IsNew ? PlPages.Profile.ReviewsNew : PlPages.Profile.ReviewsEmpty)</p>
        }
        else
        {
            @if (p.Rating is { } avg && !p.IsNew)
            {
                <p class="reviews-summary" data-testid="reviews-summary">@string.Format(PlPages.Profile.ReviewsSummaryLine, PlFormat.Rating(avg.Average), avg.Count, OpinionWord(avg.Count))</p>
            }
            <ul class="reviews">
                @foreach (var r in _reviews.Items)
                {
                    <li class="card">
                        <p class="muted">@PlPages.Profile.Reviewer · @string.Format(PlPages.Profile.ReviewRating, r.Rating) · @PlFormat.DayLong(r.CreatedAt)</p>
                        <p class="description">@r.Text</p>
                        @if (r.Reply is { } reply)
                        {
                            <div class="reply"><strong>@PlPages.Profile.ReplyHeading</strong><p class="description">@reply.Text</p></div>
                        }
                    </li>
                }
            </ul>
            @if (_reviews.NextCursor is { } next)
            {
                <a class="btn" href="@($"/gabinet/{Uri.EscapeDataString(p.Slug)}?opinie={Uri.EscapeDataString(next)}#opinie")">@PlPages.Profile.ReviewsMore</a>
            }
        }
    </section>
    </div>
    @if (p.Offerings.Count > 0)
    {
        <aside class="card summary" aria-label="@PlPages.Profile.SummaryTitle" data-testid="profile-summary">
            <p class="summary__price"><span class="muted">@PlPages.Profile.PriceFromLabel</span> <span class="num price">@Gabinety.Web.Components.Pages.Practitioners.ListFormat.Price(p.Offerings.Min(o => o.Price.AmountMinor))</span></p>
            <a class="btn btn--primary" href="@($"#oferta-{p.Offerings[0].Id}")">@PlPages.Profile.SeeTimes</a>
            <p class="muted">@PlPages.Profile.PaymentNote</p>
        </aside>
    }
    </div>
}
else if (_gone)
{
    @* A profile the Directory calls gone is a 410 with the same page as a 404 (F-09). The 404 itself is the router's not-found page, which says the same for /gabinet/... *@
    <PageMeta Title="@(PlPages.Profile.NotFoundTitle + " | " + Pl.Site.Name)" Description="@PlPages.Profile.NotFoundBody" Path="@($"/gabinet/{Uri.EscapeDataString(Slug)}")" Robots="noindex,follow" />
    <ProfileNotFoundBlock Suggestions="_suggestions" />
}
else
{
    <PageMeta Title="@(Pl.Site.Name)" Description="@PlPages.Profile.Unavailable" Path="@($"/gabinet/{Uri.EscapeDataString(Slug)}")" Robots="noindex,follow" />
    <h1>@PlPages.Profile.NotFoundTitle</h1>
    <Alert Variant="AlertVariant.Danger" TestId="unavailable">@PlPages.Profile.Unavailable</Alert>
}

@code {
    [CascadingParameter] HttpContext? Http { get; set; }
    [Parameter] public string Slug { get; set; } = "";
    [SupplyParameterFromQuery(Name = "opinie")] public string? ReviewCursor { get; set; }

    PractitionerProfileDto? _profile;
    bool _gone;
    PageDto<ReviewDto>? _reviews;
    IReadOnlyList<CategoryDto> _suggestions = [];
    Dictionary<string, string> _techs = [];

    List<string> TechNames(OfferingDto o) => [.. o.TechSlugs.Select(t => _techs.GetValueOrDefault(t) ?? t)];

    /// <summary>The purchase page of the package; it looks the package up in this profile, so the slug travels in the query (no endpoint resolves an offering id on its own).</summary>
    static string BookHref(string slug, OfferingDto o) => $"/rezerwacja/{o.Id}?gabinet={Uri.EscapeDataString(slug)}";

    /// <summary>"10 zadań, typowy czas ok. 30 min" for a task package, "500 tys. tokenów, API zgodne z OpenAI" for a chat package (<c>Units</c> are thousands of tokens).</summary>
    public static string UnitsLine(OfferingDto o) => o.Kind == "Chat"
        ? string.Format(PlPages.Profile.ChatLine, o.Units)
        : string.Format(PlPages.Profile.TasksLine, o.Units, TaskWord(o.Units), o.DurationMinutes);

    /// <summary>Polish plural of "zadanie": 1 zadanie, 2-4 zadania (not 12-14), the rest zadań.</summary>
    public static string TaskWord(int n) => n == 1 ? PlPages.Profile.TaskOne
        : n % 10 is >= 2 and <= 4 && n % 100 is < 12 or > 14 ? PlPages.Profile.TaskFew : PlPages.Profile.TaskMany;

    /// <summary>The example of the "how to connect" section: a placeholder key, never a real one.</summary>
    string CurlExample(string slug) =>
        $"curl -s {Site.ApiBaseUrl}/chat/completions \\\n  -H \"Authorization: Bearer {PlPages.Profile.ConnectKeyPlaceholder}\" \\\n  -H \"Content-Type: application/json\" \\\n  -d '{{\"model\":\"{slug}\",\"messages\":[{{\"role\":\"user\",\"content\":\"{PlPages.Profile.ConnectMessage}\"}}]}}'";

    /// <summary>Polish plural of "opinia": 1 opinia, 2-4 opinie (not 12-14), the rest opinii.</summary>
    public static string OpinionWord(int n) => n == 1 ? PlPages.Profile.OpinionOne
        : n % 10 is >= 2 and <= 4 && n % 100 is < 12 or > 14 ? PlPages.Profile.OpinionFew : PlPages.Profile.OpinionMany;

    static string BadgeLabel(string b) => b switch { "email" => PlPages.Profile.Email, "github" => PlPages.Profile.GithubBadge, "nip" => PlPages.Profile.Nip, "approved" => PlPages.Profile.Approved, _ => b };
    static string BadgeInfo(string b) => b switch { "email" => PlPages.Profile.EmailInfo, "github" => PlPages.Profile.GithubInfo, "nip" => PlPages.Profile.NipInfo, "approved" => PlPages.Profile.ApprovedInfo, _ => "" };

    protected override async Task OnParametersSetAsync()
    {
        (_profile, _gone, _reviews) = (null, false, null);
        var result = await Directory.ProfileAsync(Slug);
        if (result.Failure is { Status: 404 }) { Navigation.NotFound(); return; } // the not-found page names the missing programmer (NotFound.razor)
        if (result.Failure is { Status: 410 })
        {
            _gone = true;
            Status(StatusCodes.Status410Gone);
            _suggestions = (await Directory.TaxonomyAsync()).Value?.Problems.Take(3).ToList() ?? [];
            return;
        }
        if (!result.IsOk) { Status(StatusCodes.Status503ServiceUnavailable); return; } // an error page must not be indexed as a 200
        var p = result.Value!;

        // Independent reads: the reviews and the taxonomy. Each is a region: a failure of one never takes the page down.
        var reviewsTask = Reputation.ReviewsAsync(p.Id, ReviewCursor);
        var techTask = Directory.TaxonomyAsync(); // cached by the client; soft: without it the tags show the slug
        await Task.WhenAll(reviewsTask, techTask);
        _techs = (techTask.Result.Value?.Techs ?? []).GroupBy(t => t.Slug).ToDictionary(g => g.Key, g => g.First().NamePl);
        _reviews = reviewsTask.Result.Value;
        _profile = p;
    }

    void Status(int code)
    {
        if (Http is { Response.HasStarted: false }) Http.Response.StatusCode = code;
    }
}
