@* "wykorzystano X z Y" with a bar (C-03). The CSP allows no inline style, so the bar is the native <progress>; the words carry the meaning. *@
<div class="usage" data-testid="usage">
    <p class="usage__text">@BookingFormat.UsageLine(Kind, Used, Total)</p>
    <progress class="usage__bar" value="@Math.Min(Used, Math.Max(Total, 0))" max="@Math.Max(Total, 1)" aria-label="@BookingsText.UsageLabel">@BookingFormat.UsedPercent(Used, Total)%</progress>
</div>

@code {
    [Parameter, EditorRequired] public string Kind { get; set; } = "Tasks";
    [Parameter] public long Used { get; set; }
    [Parameter] public long Total { get; set; }
}
