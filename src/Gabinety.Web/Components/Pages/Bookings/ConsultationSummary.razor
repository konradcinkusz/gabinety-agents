@* The package summary of DESIGN-CONTRACT 5.6: one definition list used by the purchase form, the checkout and the confirmation. A missing name leaves its row out; no separator is ever printed on its own (F-03). *@
<section class="booking-summary card" aria-labelledby="@TitleId">
    <h2 id="@TitleId">@Title</h2>
    <dl class="dl">
        <dt>@BookFlowText.Summary.Offering</dt><dd>@Offering</dd>
        @if (Party is not null) {<dt>@PartyLabel</dt><dd>@Party <AiBadge /></dd>}
        <dt>@BookFlowText.Summary.Units</dt><dd data-testid="summary-units">@Units</dd>
        <dt>@BookFlowText.Summary.Validity</dt><dd data-testid="summary-validity">@Validity</dd>
        <dt>@BookFlowText.Summary.Price</dt><dd class="booking-summary__total num">@Money.Pln(PriceMinor)</dd>
    </dl>
    @ChildContent
</section>

@code {
    [Parameter] public string Title { get; set; } = BookFlowText.Summary.Title;
    [Parameter] public string TitleId { get; set; } = "summary-title";
    [Parameter, EditorRequired] public string Offering { get; set; } = "";
    /// <summary>The agent's name; null leaves the row out.</summary>
    [Parameter] public string? Party { get; set; }
    [Parameter] public string PartyLabel { get; set; } = BookFlowText.Summary.Practitioner;
    [Parameter, EditorRequired] public string Units { get; set; } = "";
    [Parameter, EditorRequired] public string Validity { get; set; } = "";
    [Parameter] public long PriceMinor { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
