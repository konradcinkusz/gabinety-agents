@page "/panel-agenta"
@attribute [Authorize]
@layout PractitionerLayout
@using Gabinety.Web.Components.Pages.Bookings
@using Gabinety.Web.Components.Pages.Shared
@inherits PractitionerPage
@inject PractitionerSchedulingClient Scheduling
@inject BookingClient Accesses
@inject TimeProvider Clock
@* Static server rendering: forms are plain posts handled by the host (antiforgery, no JavaScript needed, no circuit). Everything shown is read back from the services after each action: the
   checklist is never ticked from local state. *@

@if (LoadFailure is not null)
{
    <PageTitle>@PlPractitioner.Dashboard.MetaTitle</PageTitle>
    <h1>@PlPractitioner.Title</h1>
    <Alert Variant="AlertVariant.Danger" TestId="unavailable">@FailureText(LoadFailure) <a href="@At(PractitionerPaths.Home)">@PlPractitioner.Common.Retry</a></Alert>
}
else if (NeedsAgent)
{
    @* E-04: the account has several agents and none was chosen: the overview, with the totals over all of them. *@
    <PageTitle>@PlPractitioner.Agents.OverviewMeta</PageTitle>
    <h1>@PlPractitioner.Agents.OverviewTitle</h1>
    <p class="lead">@PlPractitioner.Agents.Intro</p>
    @if (_agentsFailed)
    {
        <Alert Variant="AlertVariant.Danger" TestId="unavailable">@PlPractitioner.Common.Unavailable <a href="@PractitionerPaths.Home">@PlPractitioner.Common.Retry</a></Alert>
    }
    else
    {
        <ul class="stack" aria-label="@PlPractitioner.Agents.ListLabel" data-testid="agents">
            @foreach (var a in _agents)
            {
                <li class="card stack" data-testid="agent" data-slug="@a.Slug">
                    <div class="cluster cluster--between">
                        <h2 class="offer__title">@a.DisplayName</h2>
                        <KindBadge Label="@ProfileStatus.Label(a.Status)" Kind="@ProfileStatus.Kind(a.Status)" />
                    </div>
                    @if (!string.IsNullOrWhiteSpace(a.Headline)) {<p class="muted">@a.Headline</p>}
                    <div class="cluster">
                        <a class="btn btn--primary" href="@($"{PractitionerPaths.Home}?agent={Uri.EscapeDataString(a.Slug)}")" aria-label="@($"{PlPractitioner.Agents.OpenPanel}: {a.DisplayName}")">@PlPractitioner.Agents.OpenPanel</a>
                        @if (a.Status == "Approved") {<a class="btn btn--secondary" href="@("/agent/" + Uri.EscapeDataString(a.Slug))" aria-label="@($"{PlPractitioner.Agents.PublicProfile}: {a.DisplayName}")">@PlPractitioner.Agents.PublicProfile</a>}
                    </div>
                </li>
            }
        </ul>
        <section class="section stack" aria-labelledby="totals-title" data-testid="totals">
            <h2 id="totals-title">@PlPractitioner.Agents.TotalRecent</h2>
            @if (_recentFailed)
            {
                <p class="muted" data-testid="recent-failed">@PlPractitioner.Agents.RecentFailed</p>
            }
            else
            {
                <p data-testid="active-packages">@string.Format(PlPractitioner.Agents.TotalActive, _activePackages)</p>
                @if (_recent.Count == 0)
                {
                    <p class="muted" data-testid="recent-empty">@PlPractitioner.Dashboard.RecentEmpty</p>
                }
                else
                {
                    <ul class="upcoming">
                        @foreach (var b in _recent)
                        {
                            <li class="upcoming__row" data-booking="@b.Id">
                                <div class="upcoming__main">
                                    <strong>@b.PackageTitle</strong>
                                    <span class="muted">@BookingFormat.MetaLine(b.Agent.DisplayName, BookingFormat.Name(b.Client?.DisplayName), string.Format(PlPractitioner.Dashboard.Bought, PlFormat.DayLong(b.StartUtc)), BookingFormat.UsageLine(b.Kind, b.UnitsUsed, b.UnitsTotal))</span>
                                </div>
                                <a href="@($"/moje/dostepy/{b.Id}?role={BookingClient.PractitionerRole}")" aria-label="@($"{PlPractitioner.Dashboard.Details}: {b.PackageTitle}")">@PlPractitioner.Dashboard.Details</a>
                            </li>
                        }
                    </ul>
                }
            }
        </section>
        <p><a class="btn btn--secondary" href="@NewAgentPath" data-testid="add-agent">@PlPractitioner.Agents.AddAnother</a></p>
    }
}
else if (NoProfile)
{
    <PageTitle>@PlPractitioner.Create.MetaTitle</PageTitle>
    <h1>@PlPractitioner.Create.Title</h1>
    <p class="lead">@PlPractitioner.Create.Intro</p>
    <p data-testid="open-to-all">@PlPractitioner.Create.OpenToAll</p>
    <section aria-labelledby="steps-title" class="section">
        <h2 id="steps-title">@PlPractitioner.Create.StepsTitle</h2>
        <ol class="steps">@foreach (var step in PlPractitioner.Create.Steps) {<li>@step</li>}</ol>
    </section>
    @if (_general is not null) {<Alert Variant="AlertVariant.Danger" TestId="create-error">@_general</Alert>}
    <form method="post" @onsubmit="CreateAsync" @formname="create-profile" class="form stack form-narrow" novalidate>
        <AntiforgeryToken />
        <FormField Id="displayName" Label="@PlPractitioner.Create.DisplayName" Hint="@PlPractitioner.Create.DisplayNameHint" Error="@Error("displayName")" Max="80" Length="_name.Length">
            <input id="@context.Id" name="displayName" value="@_name" maxlength="80" autocomplete="name" aria-describedby="@context.DescribedBy" aria-invalid="@(context.Invalid ? "true" : null)" />
        </FormField>
        <div class="form-actions"><button class="btn btn--primary" type="submit">@PlPractitioner.Create.Submit</button></div>
    </form>
}
else if (Profile is not null) @* Blazor renders once before an async OnInitialized finishes: nothing is shown until the data is there. *@
{
    <PageTitle>@PlPractitioner.Dashboard.MetaTitle</PageTitle>
    <h1>@PlPractitioner.Title</h1>
    <section class="card stack" aria-labelledby="status-title">
        <h2 id="status-title" class="visually-hidden">@PlPractitioner.Common.StatusOf</h2>
        <p class="cluster"><span>@PlPractitioner.Common.StatusOf:</span> <KindBadge Label="@ProfileStatus.Label(Profile!.Status)" Kind="@ProfileStatus.Kind(Profile!.Status)" TestId="profile-status" /></p>
        @if (!string.IsNullOrWhiteSpace(Profile!.StatusReason)) {<p>@string.Format(PlPractitioner.Status.Reason, Profile!.StatusReason)</p>}
        @if (Profile!.Status != "Approved" && ProfileStatus.Help(Profile!.Status) is { } help) {<p class="muted">@help</p>}
    </section>

    @if (NextSteps.ShowPaymentsBanner(_payments))
    {
        <div class="callout callout--warning" role="status" data-testid="payments-banner">
            <h2 class="callout__title">@PlPractitioner.Dashboard.PaymentsBannerTitle</h2>
            <p>@PlPractitioner.Dashboard.PaymentsBannerBody</p>
            <a class="btn btn--primary" href="@At(PractitionerPaths.Payments)">@PlPractitioner.Dashboard.PaymentsBannerLink</a>
        </div>
    }

    @if (Profile!.Status == "Approved")
    {
        <section class="callout callout--success stack" aria-labelledby="public-title" data-testid="public-profile">
            <h2 id="public-title" class="callout__title">@PlPractitioner.Dashboard.PublicTitle</h2>
            <p>@PlPractitioner.Dashboard.PublicBody</p>
            <div class="cluster">
                <a class="btn btn--primary" href="@PublicPath">@PlPractitioner.Dashboard.ViewPublic</a>
                <button class="btn btn--secondary" type="button" hidden data-enhance="copy" data-copy="@PublicPath" data-done="@PlPractitioner.Dashboard.Copied">@PlPractitioner.Dashboard.CopyLink</button>
            </div>
        </section>
        @if (_next is { } next) {<p data-testid="next-step">@PlPractitioner.Dashboard.NextLabel: <a href="@At(next.Href)">@next.Title</a>. <span class="muted">@next.Text</span></p>}

        <section class="section stack" aria-labelledby="recent-title" data-testid="recent">
            <h2 id="recent-title">@PlPractitioner.Dashboard.RecentTitle</h2>
            @if (_recentFailed)
            {
                <div class="callout callout--warning" role="status" data-testid="recent-failed">
                    <p>@PlPractitioner.Dashboard.RecentFailed <a href="@At(PractitionerPaths.Home)">@PlPractitioner.Common.Retry</a></p>
                </div>
            }
            else
            {
                <p data-testid="active-packages">@string.Format(PlPractitioner.Dashboard.ActiveCount, _activePackages)</p>
                @if (_recent.Count == 0)
                {
                    <p class="muted" data-testid="recent-empty">@PlPractitioner.Dashboard.RecentEmpty</p>
                }
                else
                {
                    <ul class="upcoming">
                        @foreach (var b in _recent)
                        {
                            <li class="upcoming__row" data-booking="@b.Id">
                                <div class="upcoming__main">
                                    <strong>@b.PackageTitle</strong>
                                    <span class="muted">@BookingFormat.MetaLine(BookingFormat.Name(b.Client?.DisplayName), string.Format(PlPractitioner.Dashboard.Bought, PlFormat.DayLong(b.StartUtc)), BookingFormat.UsageLine(b.Kind, b.UnitsUsed, b.UnitsTotal))</span>
                                </div>
                                <a href="@($"/moje/dostepy/{b.Id}?role={BookingClient.PractitionerRole}")" aria-label="@($"{PlPractitioner.Dashboard.Details}: {b.PackageTitle}")">@PlPractitioner.Dashboard.Details</a>
                            </li>
                        }
                    </ul>
                    <p><a href="@($"/moje/dostepy?role={BookingClient.PractitionerRole}")">@PlPractitioner.Dashboard.AllBookings</a></p>
                }
            }
        </section>
    }
    else if (OnboardingChecklist.CanBeSubmitted(Profile!.Status) || Profile!.Status == "Submitted")
    {
        <section class="section stack" aria-labelledby="checklist-title" id="lista-krokow">
            <h2 id="checklist-title">@PlPractitioner.Dashboard.ChecklistTitle</h2>
            <div class="progress-row">
                <progress class="progress" value="@(_checklist.Count - _remaining)" max="@_checklist.Count" aria-label="@PlPractitioner.Dashboard.ProgressAria"></progress>
                <p class="muted" data-testid="progress">@string.Format(PlPractitioner.Dashboard.ProgressLabel, _checklist.Count - _remaining, _checklist.Count)</p>
            </div>
            <ol class="checklist">
                @foreach (var item in _checklist)
                {
                    var isNext = Profile!.Status != "Submitted" && !item.Done && item == _checklist.First(i => !i.Done);
                    var href = item.Key == ChecklistKey.Github ? "#github-title" : item.Href is { } h ? At(h) : null;
                    <li class="checklist__item" data-item="@item.Key" data-done="@(item.Done ? "true" : "false")">
                        <div class="cluster">
                            <strong>@item.Title</strong>
                            <KindBadge Label="@(item.Done ? PlPractitioner.Dashboard.Done : PlPractitioner.Dashboard.Todo)" Kind="@(item.Done ? "success" : "neutral")" />
                            @if (isNext) {<KindBadge Label="@PlPractitioner.Dashboard.NextLabel" Kind="info" />}
                        </div>
                        @if (!item.Done)
                        {
                            <p class="muted">@item.Help @if (href is not null) {<a href="@href" aria-label="@($"{PlPractitioner.Dashboard.Fill}: {item.Title}")">@PlPractitioner.Dashboard.Fill</a>}</p>
                        }
                    </li>
                }
            </ol>
            @if (_submitNote is { } note) {<Alert Variant="note.Variant" TestId="submit-note">@note.Text</Alert>}
            @if (OnboardingChecklist.CanBeSubmitted(Profile!.Status))
            {
                <form method="post" @onsubmit="SubmitAsync" @formname="submit-profile" class="submit-row">
                    <AntiforgeryToken />
                    <button class="btn btn--primary" type="submit" disabled="@(_remaining > 0)" aria-disabled="@(_remaining > 0 ? "true" : null)" aria-describedby="submit-help">@PlPractitioner.Dashboard.Submit</button>
                    <p class="muted" id="submit-help">@(_remaining > 0 ? string.Format(PlPractitioner.Dashboard.SubmitBlocked, _remaining, StepNoun(_remaining)) : PlPractitioner.Dashboard.SubmitWhatHappens)</p>
                </form>
            }
        </section>
    }

    <section class="card stack section" aria-labelledby="github-title">
        <h2 id="github-title">@PlPractitioner.Github.Title</h2>
        @if (Profile!.GithubLinked)
        {
            <p data-testid="github-linked">@string.Format(PlPractitioner.Github.Linked, Profile!.GithubLogin)</p>
        }
        else
        {
            <p>@PlPractitioner.Github.Help</p>
            @if (_githubNote is not null) {<Alert Variant="AlertVariant.Danger" TestId="github-error">@_githubNote</Alert>}
            <form method="post" @onsubmit="RequestCodeAsync" @formname="github-request" class="form stack form-narrow" novalidate>
                <AntiforgeryToken />
                <FormField Id="githubLogin" Label="@PlPractitioner.Github.Login" Error="@Error("githubLogin")">
                    <input id="@context.Id" name="githubLogin" value="@_login" maxlength="39" autocomplete="off" aria-describedby="@context.DescribedBy" aria-invalid="@(context.Invalid ? "true" : null)" />
                </FormField>
                <div><button class="btn" type="submit">@PlPractitioner.Github.Request</button></div>
            </form>
            @* The form exists on every render: Blazor dispatches a post to a form by name in the FIRST render of that request, when the code of this response is not known yet. *@
            <form method="post" @onsubmit="VerifyCodeAsync" @formname="github-verify" class="stack" data-testid="github-code" hidden="@(_code is null)">
                <AntiforgeryToken />
                <input type="hidden" name="githubLogin" value="@_login" />
                <input type="hidden" name="code" value="@_code" />
                <p>@PlPractitioner.Github.CodeIntro</p>
                <p><code>@_code</code></p>
                <div><button class="btn btn--primary" type="submit">@PlPractitioner.Github.Verify</button></div>
            </form>
        }
    </section>

    <p class="section"><a href="@NewAgentPath" data-testid="add-agent">@PlPractitioner.Agents.AddAnother</a></p>
}

@code {
    PaymentsState _payments = PaymentsState.Unknown;
    IReadOnlyList<ChecklistItem> _checklist = [];
    IReadOnlyList<NextStep> _steps = [];
    NextStep? _next;
    int _remaining;
    string _name = "", _login = "";
    string? _code;
    string? _general, _githubNote;
    (AlertVariant Variant, string Text)? _submitNote;
    readonly Dictionary<string, string> _errors = [];
    IReadOnlyList<OfferingPrivateDto> _offers = [];
    IReadOnlyList<BookingViewDto> _recent = [];
    int _activePackages;
    bool _recentFailed, _agentsFailed;
    IReadOnlyList<PractitionerSummaryDto> _agents = [];

    const string NewAgentPath = "/panel-agenta/nowy";

    string PublicPath => "/agent/" + Uri.EscapeDataString(Profile!.Slug);

    string? Error(string field) => _errors.GetValueOrDefault(field);

    static string StepNoun(int n) => n == 1 ? PlPractitioner.Dashboard.StepOne : n % 10 is >= 2 and <= 4 && n % 100 is < 12 or > 14 ? PlPractitioner.Dashboard.StepFew : PlPractitioner.Dashboard.StepMany;

    protected override async Task OnInitializedAsync()
    {
        Scheduling.Agent = AgentSlug; // E-04: the payment account is per agent
        if (!await LoadProfileAsync(missingIsState: true))
        {
            if (NeedsAgent) await LoadOverviewAsync();
            return;
        }
        await LoadRestAsync();
        _login = Profile!.GithubLogin ?? "";
    }

    /// <summary>The overview of an account with several agents: the list, and the purchases of ALL of them (the provider-side list of Booking is per account, so it is already the sum).</summary>
    async Task LoadOverviewAsync()
    {
        var agents = Agent.AgentsAsync();
        var bookings = Accesses.MyBookingsAsync(BookingClient.PractitionerRole, null, null);
        await Task.WhenAll(agents, bookings);
        _agentsFailed = !agents.Result.IsOk;
        _agents = agents.Result.IsOk ? agents.Result.Value! : [];
        _recentFailed = !bookings.Result.IsOk;
        if (bookings.Result.IsOk)
        {
            var items = bookings.Result.Value!.Items;
            _activePackages = MyBookingsSchedule.Split(items, Clock.GetUtcNow()).Upcoming.Count;
            _recent = [.. items.OrderByDescending(b => b.StartUtc).Take(5)];
        }
        if (_agentsFailed && HttpContext is { Response.HasStarted: false }) HttpContext.Response.StatusCode = StatusCodes.Status503ServiceUnavailable;
    }

    async Task LoadRestAsync()
    {
        var offers = Agent.OfferingsAsync();
        var account = Scheduling.PaymentAccountAsync();
        Task<ApiResult<PageDto<BookingViewDto>>>? bookings = Profile!.Status == "Approved" ? Accesses.MyBookingsAsync(BookingClient.PractitionerRole, null, null) : null;
        await Task.WhenAll(offers, account, (Task?)bookings ?? Task.CompletedTask);
        if (bookings is not null) // the region fails soft: the rest of the dashboard is already known
        {
            _recentFailed = !bookings.Result.IsOk;
            if (bookings.Result.IsOk)
            {
                IReadOnlyList<BookingViewDto> items = AgentSlug is null ? bookings.Result.Value!.Items : [.. bookings.Result.Value!.Items.Where(b => b.Agent.Slug == Profile!.Slug)]; // E-04: a chosen agent sees only its own purchases
                _activePackages = MyBookingsSchedule.Split(items, Clock.GetUtcNow()).Upcoming.Count; // the first page of the list: the newest purchases
                _recent = [.. items.OrderByDescending(b => b.StartUtc).Take(5)]; // a package starts when it is bought
            }
        }
        _offers = offers.Result.IsOk ? offers.Result.Value! : [];
        _payments = NextSteps.PaymentsOf(account.Result);
        _checklist = OnboardingChecklist.Build(Profile!, _offers);
        _remaining = OnboardingChecklist.Remaining(_checklist);
        _steps = NextSteps.Build(Profile!, _offers, _payments);
        _next = NextSteps.Next(_steps);
    }

    async Task CreateAsync()
    {
        _name = Posted.Text("displayName");
        if (_name.Length is < 2 or > 80) { _errors["displayName"] = FieldErrors.From(new ApiFailure(422, "validation_failed", ["displayName"]), new Dictionary<string, string?>())["displayName"]; return; }
        var r = await Agent.CreateProfileAsync(_name);
        if (r.IsOk) { Navigation.NavigateTo($"{PractitionerPaths.Home}?{FlashKey.Parameter}={FlashKey.GabinetCreated}"); return; } // the account's first agent: it is the only one, so no agent parameter
        if (r.Failure!.Names("displayName")) _errors["displayName"] = FieldErrors.From(r.Failure, new Dictionary<string, string?>())["displayName"];
        else _general = r.Failure.Code == "practitioner_exists" ? PlPractitioner.Create.Exists : r.Failure.Status is 0 or 503 ? PlPractitioner.Common.Unavailable : PlPractitioner.Create.Failed;
    }

    async Task SubmitAsync()
    {
        var r = await Agent.SubmitAsync();
        if (r.IsOk) { Done(PractitionerPaths.Home, FlashKey.ProfileSubmitted); return; }
        var f = r.Failure!;
        if (f.Code == "submit_incomplete")
        {
            var items = string.Join(", ", OnboardingChecklist.FromServer(f.Unmet ?? []).Select(k => new ChecklistItem(k, false).Title));
            _submitNote = (AlertVariant.Danger, string.Format(PlPractitioner.Dashboard.Incomplete, items));
            await RefreshAsync();
        }
        else _submitNote = (AlertVariant.Danger, f.Code == "invalid_transition" ? PlPractitioner.Dashboard.InvalidTransition : FieldErrors.General(f, PlPractitioner.Dashboard.SubmitFailed));
    }

    async Task RequestCodeAsync()
    {
        _login = Posted.Text("githubLogin");
        if (!System.Text.RegularExpressions.Regex.IsMatch(_login, "^[A-Za-z0-9-]{1,39}$")) { _errors["githubLogin"] = PlPractitioner.Github.InvalidLogin; return; }
        var r = await Agent.RequestGithubLinkAsync(_login);
        if (r.IsOk) _code = r.Value!.Code;
        else _githubNote = r.Failure!.Status is 0 or 503 ? FieldErrors.General(r.Failure, PlPractitioner.Github.Failed) : r.Failure.Names("githubLogin") ? PlPractitioner.Github.InvalidLogin : PlPractitioner.Github.Failed;
    }

    async Task VerifyCodeAsync()
    {
        _login = Posted.Text("githubLogin");
        var posted = Posted.Text("code");
        _code = System.Text.RegularExpressions.Regex.IsMatch(posted, "^gabinety-verify-[A-Za-z0-9]{10}$") ? posted : null; // the code is public by design (it goes into a GitHub bio); only its shape is checked
        var r = await Agent.VerifyGithubLinkAsync();
        if (r.IsOk) { Done(PractitionerPaths.Home); return; }
        _githubNote = r.Failure! switch
        {
            { Code: "github_not_linked" } when r.Failure!.Names("githubLogin") => PlPractitioner.Github.AlreadyLinked,
            { Code: "github_not_linked" } => PlPractitioner.Github.NotLinked,
            { Status: 503 } => PlPractitioner.Github.Unavailable,
            _ => PlPractitioner.Github.Failed,
        };
    }

    async Task RefreshAsync()
    {
        await LoadProfileAsync(missingIsState: true);
        await LoadRestAsync();
    }
}
