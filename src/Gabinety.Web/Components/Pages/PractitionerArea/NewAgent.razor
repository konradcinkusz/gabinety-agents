@page "/panel-agenta/nowy"
@attribute [Authorize]
@layout PractitionerLayout
@inherits PractitionerPage
@* E-04: one more agent for the signed-in provider account. A plain post (antiforgery, no JavaScript): the Directory creates the agent (422 too_many_agents at the account's limit) and the provider lands in
   that agent's panel, with the agent in the address. *@
<PageTitle>@PlPractitioner.Agents.NewMeta</PageTitle>
<h1>@PlPractitioner.Agents.NewTitle</h1>
<p class="lead">@PlPractitioner.Agents.NewIntro</p>
@if (_general is not null) {<Alert Variant="AlertVariant.Danger" TestId="create-error">@_general</Alert>}
<form method="post" @onsubmit="CreateAsync" @formname="create-agent" class="form stack form-narrow" novalidate>
    <AntiforgeryToken />
    <FormField Id="displayName" Label="@PlPractitioner.Create.DisplayName" Hint="@PlPractitioner.Create.DisplayNameHint" Error="@_nameError" Max="80" Length="_name.Length">
        <input id="@context.Id" name="displayName" value="@_name" maxlength="80" autocomplete="off" aria-describedby="@context.DescribedBy" aria-invalid="@(context.Invalid ? "true" : null)" />
    </FormField>
    <div class="form-actions">
        <button class="btn btn--primary" type="submit">@PlPractitioner.Agents.NewSubmit</button>
        <a class="btn btn--ghost" href="@PractitionerPaths.Home">@PlPractitioner.Offers.Cancel</a>
    </div>
</form>

@code {
    string _name = "";
    string? _nameError, _general;

    async Task CreateAsync()
    {
        _name = Posted.Text("displayName");
        if (_name.Length is < 2 or > 80) { _nameError = FieldErrors.From(new ApiFailure(422, "validation_failed", ["displayName"]), new Dictionary<string, string?>())["displayName"]; return; }
        var r = await Practitioner.CreateProfileAsync(_name);
        if (r.IsOk) { Navigation.NavigateTo($"{PractitionerPaths.Home}?agent={Uri.EscapeDataString(r.Value!.Slug)}&{FlashKey.Parameter}={FlashKey.GabinetCreated}"); return; }
        if (r.Failure!.Names("displayName")) _nameError = FieldErrors.From(r.Failure, new Dictionary<string, string?>())["displayName"];
        else _general = r.Failure.Code == "too_many_agents" ? PlPractitioner.Agents.TooMany : r.Failure.Status is 0 or 503 ? PlPractitioner.Common.Unavailable : PlPractitioner.Agents.Failed;
    }
}
